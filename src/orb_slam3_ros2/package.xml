<?xml version="1.0"?>
<package format="3">
  <name>orb_slam3_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 monocular wrapper for ORB-SLAM3 used by the rear camera calibration workflow.</description>
  <maintainer email="maintainer@example.com">Autoware Integration</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>boost</depend>
  <depend>cv_bridge</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>openssl</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
